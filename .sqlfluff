[sqlfluff]
dialect = snowflake
templater = dbt
runaway_limit = 10
max_line_length = 140
indent_unit = space
large_file_skip_char_limit = 0
large_file_skip_byte_limit = 150000
max_parse_depth = 1000

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:capitalisation.functions]
capitalisation_policy = lower

[sqlfluff:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:aliasing.table]
aliasing = explicit

[sqlfluff:aliasing.column]
aliasing = explicit

[sqlfluff:aliasing.expression]
allow_scalar = False

[sqlfluff:ambiguous.column_references]
group_by_and_order_by_style = implicit

[sqlfluff:references.quoting]
ignore_words = default, limit
prefer_quoted_keywords = False

[sqlfluff:templater:dbt]
project_dir = ./
profiles_dir = ~/.dbt

[sqlfluff:templater:jinja]
load_macros_from_path = macros/
library_path = sqlfluff_libs